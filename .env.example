# Proveedor: groq, anthropic u ollama
LLM_PROVIDER=groq
# Modelo con soporte de herramientas disponible en tu cuenta Groq
LLM_MODEL=openai/gpt-oss-20b
# Solo para LLM_PROVIDER=groq. Nunca lo subas al repositorio ni lo pegues en el chat.
GROQ_API_KEY=
# Solo para LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Solo para LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
MAX_ITER=25
MAX_TOKENS_SESION=150000
RATE_LIMIT_POR_MIN=10
LLM_TIMEOUT_MS=60000
PORT=3000
